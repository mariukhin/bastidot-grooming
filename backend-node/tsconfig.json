{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Node сам стрипає типи і виконує .ts напряму — tsc лише перевіряє,
    // нічого не емітить. Тому дозволяємо .ts у import і вимикаємо emit.
    "noEmit": true,
    "allowImportingTsExtensions": true,

    // Стриппінг працює лише з erasable-only TS (без enum/namespace/
    // param-properties). Цей прапор форсить сумісність на рівні tsc.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],

    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
