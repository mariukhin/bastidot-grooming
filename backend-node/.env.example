# Скопіюйте у .env для локальної розробки.
# На хостингу ці ж ключі задаються через панель змінних оточення — файлу .env там немає,
# і скрипти це переживають (--env-file-if-exists).

# production вмикає перевірку CORS_ORIGINS
APP_ENV=development
PORT=8081
CONTEXT_TIMEOUT=2

# Через кому. Перевіряється тільки коли APP_ENV=production —
# при порожньому списку на проді всі крос-доменні запити будуть заблоковані.
CORS_ORIGINS=http://localhost:3000,https://bastidot-grooming.vercel.app

# MongoDB Atlas cluster host, e.g. cluster0.xxxxx.mongodb.net (no mongodb+srv:// prefix, no credentials)
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

ACCESS_TOKEN_EXPIRY_HOUR=2
REFRESH_TOKEN_EXPIRY_HOUR=168
# openssl rand -hex 32
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

GOOGLE_CLIENT_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# За скільки годин до візиту закривається скасування/перенесення онлайн
ORDER_SELF_SERVICE_CUTOFF_HOURS=3

# Надсилати в Telegram. Порожнє = тільки коли APP_ENV=production.
# Локально лишайте порожнім, інакше тестові записи полетять у робочий чат.
TELEGRAM_ENABLED=

REMINDER_INACTIVE_DAYS=60
REMINDER_COOLDOWN_DAYS=30
REMINDER_WARM_COUNT=6
REMINDER_COLD_COUNT=2
REMINDER_NOANSWER_COUNT=2
REMINDER_RUN_AT=11:00
REMINDER_EVERY_DAYS=2
REMINDER_TIME_ZONE=Europe/Kyiv
# true — планувальник дайджесту крутиться в самому процесі сервера.
# На проді увімкнено через fly.toml. Локально лишайте порожнім, інакше
# запуск сервера з ноутбука надішле дайджест у робочий чат.
REMINDER_IN_PROCESS=

# --- Коди підтвердження телефону (OTP) ---
# Порожнє = доставка лише коли APP_ENV=production. Локально код пишеться в лог
# сервера, нікуди не летить і нічого не коштує.
OTP_DELIVERY_ENABLED=
OTP_TTL_MINUTES=5
# Telegram Gateway (https://gateway.telegram.org) — безкоштовна перевірка
# checkSendAbility і $0.01 за доставлений код.
TELEGRAM_GATEWAY_TOKEN=
# TurboSMS — запасний канал, коли код не можна доставити в Telegram.
TURBOSMS_TOKEN=
# Зареєстроване альфа-імʼя відправника
TURBOSMS_SENDER=

# --- Cloudflare R2 (фото улюбленців і аватари) ---
# Порожні ключі = фото зберігаються локально в backend-node/.uploads
# і роздаються через /uploads. На проді задати всі чотири + публічний домен.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Публічний домен бакета, напр. https://media.bastidot.com.ua
R2_PUBLIC_URL=
