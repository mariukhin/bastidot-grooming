{
  "name": "bastidot-backend-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --experimental-strip-types --env-file-if-exists=.env src/server.ts",
    "dev": "node --experimental-strip-types --watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "reminder:run": "node --experimental-strip-types --env-file-if-exists=.env src/features/reminder/run.ts",
    "reminder:preview": "node --experimental-strip-types --env-file-if-exists=.env src/features/reminder/run.ts --dry-run",
    "client:apply": "node --experimental-strip-types --env-file-if-exists=.env src/scripts/apply-client-json.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "express": "^5.2.1",
    "mongodb": "^7.5.0",
    "multer": "^2.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
